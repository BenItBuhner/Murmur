<?xml version="1.0" encoding="utf-8"?>
<!--
    Window themes only cover the frame before Compose draws and the window background behind the
    keyboard; MurmurTheme (ui/theme/Theme.kt) owns every colour on screen. Theme.Murmur follows the
    system (values-night overrides it); MainActivity switches to the Light/Dark variants when the
    user forces a mode. values-v31 swaps in the DeviceDefault parents so the window background picks
    up wallpaper (Material You) colours too.
-->
<resources>
    <style name="Theme.Murmur.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Platform dialogs (the account sheet) dim with the same scrim as the drawer: black at 40 % in both modes. -->
        <item name="android:backgroundDimAmount">0.4</item>
    </style>

    <style name="Theme.Murmur" parent="Theme.Murmur.Base" />

    <style name="Theme.Murmur.Light" parent="Theme.Murmur.Base" />

    <style name="Theme.Murmur.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Platform dialogs (the account sheet) dim with the same scrim as the drawer: black at 40 % in both modes. -->
        <item name="android:backgroundDimAmount">0.4</item>
    </style>

    <!--
        The external-entry trampoline (entry/DictationEntryActivity.kt): fully transparent, no
        window animation, nothing drawn. It has to actually reach onResume — the dictation is
        started from the resumed activity, and the microphone foreground service must be started
        by an app that is in front (Android 14/15 while-in-use rule) — so it is Translucent, not
        NoDisplay, which never resumes.
    -->
    <style name="Theme.Murmur.Trampoline" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
