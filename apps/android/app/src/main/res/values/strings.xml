<resources>
    <string name="app_name">Murmur</string>
    <string name="accessibility_service_label">Murmur dictation</string>
    <string name="accessibility_service_description">Shows the Murmur dictation pill above the keyboard and inserts transcribed text into the focused text field. Murmur never reads screen content except the text field you are dictating into.</string>
    <string name="notification_channel_name">Recording indicator</string>
    <string name="notification_channel_description">Shown while Murmur is listening, because Android requires it for the microphone. Turn it off here to hide it; dictation keeps working.</string>
    <string name="notification_recording">Listening…</string>
    <string name="notification_channel_updates">Updates</string>

