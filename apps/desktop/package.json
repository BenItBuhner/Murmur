{
  "name": "murmur",
  "version": "0.2.0",
  "description": "Murmur - hold a key, speak, and clean text lands wherever your cursor is. Wispr Flow-style voice dictation for Windows and Linux.",
  "main": "./out/main/index.js",
  "author": "Murmur contributors",
  "homepage": "https://github.com/BenItBuhner/voxflow",
  "repository": {
    "type": "git",
    "url": "https://github.com/BenItBuhner/voxflow.git",
    "directory": "apps/desktop"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "MURMUR_LIVE=1 vitest run tests/live",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "build:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@clerk/electron": "0.0.41",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "convex": "1.45.0",
    "electron-store": "^8.2.0",
    "koffi": "^3.2.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "lucide-react": "^0.540.0",
    "prettier": "^3.7.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.0",
    "zod": "^4.1.0"
  }
}
