<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The sync engine watches the default network come and go, to try again the moment it is back
         and to show Offline for no network (cloud/CloudSync.kt); the Clerk SDK asks for this too. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The dictation's haptics (dictation/Haptics.kt) go through the Vibrator, which refuses every
         call without this; the button's own drag ticks go through View.performHapticFeedback and
         never needed it. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- A partial wake lock while recording and while a dictation is processed: a 30-minute session
         with the screen off must not have its CPU or network put to sleep. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Holding the overlay permission exempts us from background foreground-service-start
         restrictions, so recording can begin from the accessibility overlay pill. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- The install permissions of the self-updater live in src/direct/AndroidManifest.xml: the
         Google Play flavor has no updater and asks for none of them. -->

    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- usesCleartextTraffic: a self-hosted whisper server on the LAN (http://192.168.x.x:8000/v1)
         is a first-class provider, and Android otherwise refuses every plain-http base URL. Hosted
         providers keep using https.
         enableOnBackInvokedCallback: predictive back. The system previews going home (Android 13+,
         on by default from 15) and streams the gesture's progress to the app, which ui/BackStackHost
         turns into the in-app preview. Nothing here handles KEYCODE_BACK, so the switch is safe. -->
    <application
        android:name=".MurmurApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Murmur">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The static launcher shortcuts (res/xml/shortcuts.xml): the app's icon is
                 long-pressed for "Dictate", and external triggers (Samsung RegiStar back taps,
                 Modes and Routines, Tasker) pick the same shortcuts. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The trampoline external entry points land in (entry/EntryCommands.kt for the actions
             and extras). Nothing is ever shown in the common case: the command runs and the
             activity finishes inside onCreate, before a window exists — the system fires app
             shortcuts with FLAG_ACTIVITY_TASK_ON_HOME, and a trampoline that ever becomes the
             visible task would return the user to the home screen when it finishes, out of the
             app they were dictating into. Out of Recents, no history; exported because Samsung's
             RegiStar, Modes and Routines, launchers and Tasker all fire at it from outside. -->
        <activity
            android:name=".entry.DictationEntryActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Murmur.Trampoline">
            <intent-filter>
                <action android:name="app.murmur.android.action.TOGGLE_DICTATION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="app.murmur.android.action.START_DICTATION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="app.murmur.android.action.STOP_DICTATION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="app.murmur.android.action.CANCEL_DICTATION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.MurmurAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".service.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- The "Dictate" Quick Settings tile. It never starts the microphone service itself: a
             tap fires the same TOGGLE at the trampoline, where the gates, the keyguard and the
             debounce apply as for every other entry point. -->
        <service
            android:name=".entry.DictationTileService"
            android:exported="true"
            android:label="@string/tile_dictate"
            android:icon="@drawable/ic_shortcut_mic"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
