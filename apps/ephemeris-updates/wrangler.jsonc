// Ephemeris's private update feed: a GitHub-compatible releases endpoint for the desktop updater,
// whose own repository is private (the anonymous GitHub API cannot read its releases). Workers
// Free plan + Workers KV free tier (R2 is not enabled on the account; installers go in 24 MiB chunks). Only a build baked with the feed's key can read it; see README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ephemeris-updates",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "minify": true,
  // No id on purpose: the first deploy provisions the namespace and later deploys reuse it.
  "kv_namespaces": [{ "binding": "FEED" }]
  // Secrets FEED_KEY (the path segment every request starts with) and PUBLISH_KEY (bearer token for
  // uploads), set by .github/workflows/deploy-ephemeris-updates.yml from config:keys in the namespace.
}
