# Murmur desktop - build-time cloud configuration (copy to .env or export in CI).
#
# Leave every value unset for a fully local build: no account, no sync, data stays on the device.
# Set both of the first two to build against a Murmur cloud instance (packages/backend on Convex,
# identity by Clerk). Values can also be overridden at runtime with the MURMUR_* variables of the
# same name (MURMUR_CONVEX_URL, MURMUR_CLERK_PUBLISHABLE_KEY, MURMUR_ACCOUNT_MODE).

# Convex deployment URL (Convex dashboard -> Settings -> URL & Deploy Key).
VITE_CONVEX_URL=

# Clerk publishable key (Clerk dashboard -> API keys). pk_test_... for development instances,
# pk_live_... for production.
VITE_CLERK_PUBLISHABLE_KEY=

# How the build treats accounts: required (default when the two values above are set), optional
# ("continue without an account" is offered) or off.
VITE_MURMUR_ACCOUNT_MODE=required

# Custom URL scheme used to serve the renderer and receive OAuth callbacks. Only change this for
# side-by-side test builds; it must match the Linux .desktop MimeType and the macOS protocols entry.
VITE_MURMUR_DEEP_LINK_SCHEME=murmur

# GitHub repository (owner/name) whose Releases the in-app updater follows. Defaults to the
# `repository` field of package.json; CI sets it to the repository that runs the build. At runtime
# MURMUR_UPDATE_REPO overrides it and MURMUR_UPDATE_API_BASE points the feed at another server
# (assets must then be served from that same origin) for testing.
VITE_MURMUR_UPDATE_REPO=
