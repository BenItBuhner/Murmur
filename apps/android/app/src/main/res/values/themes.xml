<?xml version="1.0" encoding="utf-8"?>
<!--
    Window themes only cover the frame before Compose draws and the window background behind the
    keyboard; MurmurTheme (ui/theme/Theme.kt) owns every colour on screen. Theme.Murmur follows the
    system (values-night overrides it); MainActivity switches to the Light/Dark variants when the
    user forces a mode. values-v31 swaps in the DeviceDefault parents so the window background picks
    up wallpaper (Material You) colours too.
-->
<resources>
    <style name="Theme.Murmur.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Platform dialogs (the account sheet) dim with the same scrim as the drawer: black at 40 % in both modes. -->
        <item name="android:backgroundDimAmount">0.4</item>
    </style>

    <style name="Theme.Murmur" parent="Theme.Murmur.Base" />

    <style name="Theme.Murmur.Light" parent="Theme.Murmur.Base" />

    <style name="Theme.Murmur.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Platform dialogs (the account sheet) dim with the same scrim as the drawer: black at 40 % in both modes. -->
        <item name="android:backgroundDimAmount">0.4</item>
    </style>

    <!--
        The external-entry trampoline (entry/DictationEntryActivity.kt). In the common case it
        never shows anything: the command runs and it finishes inside onCreate, before a window
        exists (a trampoline that ever became the visible task would return the user to the home
        screen, because shortcuts are fired with FLAG_ACTIVITY_TASK_ON_HOME). The window is still
        needed for the paths that keep the activity alive — asking the keyguard to dismiss, and
        taking the user to Murmur when a gate is shut — so it is fully transparent, no animation,
        and Translucent rather than NoDisplay (NoDisplay must finish before it resumes).
    -->
    <style name="Theme.Murmur.Trampoline" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
