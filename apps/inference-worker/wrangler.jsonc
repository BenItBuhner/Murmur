// Murmur's managed inference gateway (see src/index.ts). Fits the Workers Free plan: no bindings,
// no Durable Objects, no KV. Deployed from main by .github/workflows/deploy-inference-worker.yml;
// the public values live here, the secrets (MURMUR_WORKER_SECRET, MURMUR_INFERENCE_STT_KEY,
// MURMUR_INFERENCE_LLM_KEY) are applied from the repository's Actions secrets by that workflow.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murmur-inference",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "minify": true,
  "observability": { "enabled": true },
  "vars": {
    // Same value as CLERK_JWT_ISSUER_DOMAIN in the Convex deployment hardy-fish-542.
    "CLERK_JWT_ISSUER_DOMAIN": "https://clerk.murmur.techlitnow.com",
    // The Convex deployment's HTTP actions origin; /worker/* lives there.
    "CONVEX_SITE_URL": "https://hardy-fish-542.convex.site",
    // Provider endpoints and models: the same MURMUR_INFERENCE_* values the Convex deployment has.
    "MURMUR_INFERENCE_STT_URL": "https://infer.techlitnow.com/v1",
    "MURMUR_INFERENCE_STT_MODEL": "transcribe-1",
    "MURMUR_INFERENCE_STT_FAST_MODEL": "murmur-fast-transcribe",
    "MURMUR_INFERENCE_STT_HEDGE_MODEL": "murmur-bg-transcribe",
    "MURMUR_INFERENCE_STT_RELEASE_FAST": "on",
    // Background pieces (sent while the user is still speaking, x-murmur-tier: background) go to
    // slower or cheaper pools; the release stays on the fastest ones and is hedged.
    "MURMUR_INFERENCE_STT_BG_MODEL": "murmur-bg-transcribe",
    "MURMUR_INFERENCE_LLM_URL": "https://infer.techlitnow.com/v1",
    "MURMUR_INFERENCE_LLM_MODEL": "complete",
    // Releases format on gpt-oss-120b: on the eval corpus it passed 42 of 50 against 38 for the 20b
    // (murmur-fast-format), for about 50 ms more at the median (0.74 s against 0.69 s).
    "MURMUR_INFERENCE_LLM_FAST_MODEL": "complete",
    "MURMUR_INFERENCE_LLM_BG_MODEL": "complete",
    // The release's backup formatter, on another provider than Groq so a Groq rate-limit cooldown
    // (all Groq models at once) does not take it down too. murmur-bg-format (nvidia) took 7 s at the
    // median and up to a minute; gemini-3.6-flash answered in about 1 s and passed 22 of 23 evals.
    "MURMUR_INFERENCE_LLM_HEDGE_MODEL": "gemini-3.6-flash",
    "MURMUR_INFERENCE_LLM_RELEASE_FAST": "on",
    // Where limit errors link to; same value as MURMUR_SITE_URL in the Convex deployment.
    "MURMUR_SITE_URL": "https://murmur.techlitnow.com"
  }
  // Secrets, applied by the deploy workflow from the repository's Actions secrets (the same
  // values the Convex deployment carries): MURMUR_WORKER_SECRET, MURMUR_INFERENCE_STT_KEY,
  // MURMUR_INFERENCE_LLM_KEY. Optional vars left unset, like in Convex: MURMUR_INFERENCE_STT_PRO_MODEL,
  // _LLM_PRO_MODEL and MURMUR_BILLING_ENABLED (billing stays off).
}
