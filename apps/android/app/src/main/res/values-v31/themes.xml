<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: DeviceDefault windows already carry the wallpaper (Material You) colours. -->
<resources>
    <style name="Theme.Murmur.Base" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Platform dialogs (the account sheet) dim with the same scrim as the drawer: black at 40 % in both modes. -->
        <item name="android:backgroundDimAmount">0.4</item>
    </style>

    <style name="Theme.Murmur.Dark" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Platform dialogs (the account sheet) dim with the same scrim as the drawer: black at 40 % in both modes. -->
        <item name="android:backgroundDimAmount">0.4</item>
    </style>
</resources>
